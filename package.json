{
  "name": "dlsdev",
  "version": "1.3.0",
  "description": "Interactive terminal user interface portfolio for Diego Letelier",
  "module": "index.tsx",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Diego Letelier <diegoleteliers10@gmail.com> (https://diegoletelierdev.vercel.app/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegoleteliers10/dldev-tui.git"
  },
  "homepage": "https://github.com/diegoleteliers10/dldev-tui#readme",
  "bugs": {
    "url": "https://github.com/diegoleteliers10/dldev-tui/issues"
  },
  "keywords": [
    "tui",
    "opentui",
    "terminal",
    "portfolio",
    "react",
    "cli",
    "developer-portfolio"
  ],
  "bin": {
    "dlsdev": "bin.cjs"
  },
  "files": [
    "dist",
    "bin.cjs"
  ],
  "scripts": {
    "dev": "bun run --watch index.tsx",
    "tui": "bun run index.tsx",
    "build": "bun build ./index.tsx --outfile=./dist/index.js --target=node --external=@opentui/core --external=@opentui/core-darwin-x64 --external=@opentui/core-darwin-arm64 --external=@opentui/core-linux-x64 --external=@opentui/core-linux-arm64 --external=@opentui/core-win32-x64 --external=@opentui/core-win32-arm64 --external=@opentui/core-linux-arm64-musl",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.4.2",
    "@opentui/react": "^0.4.2",
    "react": "^19.2.6"
  }
}
